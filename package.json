{
  "name": "meshpad",
  "version": "0.0.0",
  "description": "A single-file toolkit for mobile-first Three.js game prototypes.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.js" },
    "./three": { "types": "./three.d.ts", "import": "./src/three.js" },
    "./package.json": "./package.json",
    "./tsconfig": "./tsconfig.json"
  },
  "bin": { "meshpad": "./bin/meshpad.js" },
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node bin/meshpad.js dev examples/hello-world/game.ts",
    "build": "node bin/meshpad.js build examples/hello-world/game.ts",
    "preview": "node bin/meshpad.js preview",
    "render": "node bin/meshpad.js render examples/hello-world/game.ts",
    "typecheck": "node bin/meshpad.js typecheck examples/hello-world/game.ts",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/browser/*.test.js"
  },
  "dependencies": {
    "@types/three": "^0.185.0",
    "playwright": "^1.64.1",
    "three": "^0.187.0",
    "vite": "^8.3.6",
    "typescript": "~6.0.3"
  },
  "sideEffects": ["./index.js", "**/*.css"],
  "files": [
    "index.js", "index.d.ts", "three.d.ts", "tsconfig.json", "src", "bin", "templates"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/havaliza/meshpad.git"
  },
  "keywords": ["three", "vite", "game", "prototype", "mobile", "3d"],
  "author": "",
  "license": "ISC"
}
